{
  "manifest_version": 3,
  "name": "AtCoder Pulse - Analytics & Unsolved Tracker",
  "version": "1.0.0",
  "description": "Deep profile analytics, interactive difficulty breakdown charts, and Codeforces-style unsolved problem tracker for AtCoder.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "AtCoder Pulse",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service_worker.js",
    "scripts": [
      "background/service_worker.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "atcoder-pulse@extension.local",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://atcoder.jp/*",
    "https://kenkoooo.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://atcoder.jp/users/*"
      ],
      "css": [
        "content/content.css"
      ],
      "js": [
        "utils/colors.js",
        "utils/db.js",
        "utils/api.js",
        "utils/charts.js",
        "utils/analyzer.js",
        "content/dashboard.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://atcoder.jp/contests/*/submissions*"
      ],
      "js": [
        "utils/db.js",
        "content/submission_tracker.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
